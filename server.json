      "sizes": [
        "64x64"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/Kedicode-TR/kedimeet-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "kedimeet-mcp",
      "version": "1.0.2",
